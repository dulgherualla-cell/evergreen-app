---
import Layout from "../layouts/Layout.astro";
import BrandPanel from "../components/BrandPanel.astro";
import AvatarPicker from "../components/AvatarPicker.astro";
import { u, str, emailOk, validAvatar, safeNext } from "../lib/util";
import { one, run } from "../lib/db";
import { hashPassword, newId, createSession } from "../lib/auth";

const locals = Astro.locals as any;
const next = safeNext(Astro.url.searchParams.get("next"));
if (locals.user) return Astro.redirect(u(next));

let err = "";
let name = "";
let email = "";
let icon: string | null = null;
let color: string | null = null;

if (Astro.request.method === "POST" && locals.db) {
  const fd = await Astro.request.formData();
  name = str(fd, "name", 40);
  email = str(fd, "email", 120).toLowerCase();
  const pass = String(fd.get("password") || "");
  const av = validAvatar(str(fd, "avatar_icon"), str(fd, "avatar_color"));
  icon = av?.icon ?? null;
  color = av?.color ?? null;
  if (!name) err = "Вкажіть своє ім'я.";
  else if (!emailOk(email)) err = "Перевірте email: він має виглядати як name@gmail.com.";
  else if (pass.length < 8) err = "Пароль має містити щонайменше 8 символів.";
  else if (pass.length > 200) err = "Пароль задовгий.";
  else if (!fd.get("agree")) err = "Підтвердіть згоду з умовами користування.";
  else if (await one(locals.db, "SELECT id FROM users WHERE email = ?", email)) err = "Акаунт з такою поштою вже існує. Увійдіть.";
  if (!err) {
    const { hash, salt } = await hashPassword(pass);
    const id = newId();
    await run(
      locals.db,
      "INSERT INTO users (id, email, name, pass_hash, pass_salt, avatar_icon, avatar_color, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
      id, email, name, hash, salt, icon, color, Date.now()
    );
    await createSession(locals.db, id, Astro.cookies, Astro.url.protocol === "https:");
    return Astro.redirect(u(next));
  }
}
---
<Layout title="Реєстрація · Evergreen">
  <section class="auth">
    <BrandPanel />
    <div class="auth-side">
      <form class="auth-card" method="post" novalidate>
        <span class="eyebrow"><svg><use href="#spark"></use></svg>Кабінет Evergreen</span>
        <h1>Створіть акаунт</h1>
        <p style="color:var(--muted)">Акаунт потрібен, щоб створювати розіграші, приєднуватися до груп і заповнювати анкету.</p>
        {err && <p class="err">{err}</p>}
        <div class="field"><label for="su-name">Ваше ім'я</label><input class="input" id="su-name" name="name" autocomplete="name" maxlength="40" value={name} required /></div>
        <div class="field"><label for="su-email">Email</label><input class="input" id="su-email" name="email" type="email" autocomplete="email" placeholder="you@gmail.com" value={email} required /></div>
        <div class="field"><label for="su-pass">Пароль</label><input class="input" id="su-pass" name="password" type="password" autocomplete="new-password" minlength="8" required /><span class="hint">Щонайменше 8 символів.</span></div>
        <div class="field"><span class="lab">Ваш аватар</span><AvatarPicker prefix="su" icon={icon} color={color} /></div>
        <label class="check"><input type="checkbox" name="agree" value="1" /> Погоджуюсь з умовами користування та політикою конфіденційності</label>
        <button class="btn block" type="submit">Створити акаунт</button>
        <div class="center-row"><span>Вже маєте акаунт?</span><a class="link" href={u(`/signin?next=${encodeURIComponent(next)}`)}>Увійти</a></div>
      </form>
    </div>
  </section>
</Layout>
