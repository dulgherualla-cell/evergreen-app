---
import Layout from "../layouts/Layout.astro";
import AvatarPicker from "../components/AvatarPicker.astro";
import { u, str, genCode, validAvatar } from "../lib/util";
import { one, run } from "../lib/db";

const locals = Astro.locals as any;
const user = locals.user;
if (!user) return Astro.redirect(u("/signup?next=/create"));

let err = "";
const v = { name: "", budget: "", date: "2026-12-30", you: user.name, note: "" };

if (Astro.request.method === "POST" && locals.db) {
  const fd = await Astro.request.formData();
  v.name = str(fd, "name", 60);
  v.budget = str(fd, "budget", 30);
  v.date = /^\d{4}-\d{2}-\d{2}$/.test(str(fd, "date")) ? str(fd, "date") : "";
  v.you = str(fd, "you", 40);
  v.note = str(fd, "note", 500);
  const av = validAvatar(str(fd, "avatar_icon"), str(fd, "avatar_color"));
  if (!v.name || !v.you) err = "Вкажіть назву групи і своє ім'я.";
  if (!err) {
    let code = genCode();
    for (let i = 0; i < 5 && (await one(locals.db, "SELECT code FROM groups WHERE code = ?", code)); i++) code = genCode();
    const now = Date.now();
    await run(
      locals.db,
      "INSERT INTO groups (code, name, budget, date, note, owner_id, owner_name, created_at, drawn) VALUES (?, ?, ?, ?, ?, ?, ?, ?, 0)",
      code, v.name, v.budget, v.date, v.note, user.id, v.you, now
    );
    if (fd.get("join")) {
      await run(
        locals.db,
        "INSERT INTO members (group_code, user_id, name, avatar_icon, avatar_color, joined_at) VALUES (?, ?, ?, ?, ?, ?)",
        code, user.id, v.you, av?.icon ?? null, av?.color ?? null, now
      );
    }
    return Astro.redirect(u(`/group/${code}?msg=created`));
  }
}
---
<Layout title="Новий розіграш · Evergreen" active="cabinet">
  <section class="wrap app" style="max-width:760px">
    <a class="back" href={u("/cabinet")}>← До кабінету</a>
    <div class="app-head"><div><span class="eyebrow"><svg><use href="#spark"></use></svg>Новий розіграш</span><h1>Створіть групу</h1></div></div>
    <form class="panel" method="post" novalidate>
      {err && <p class="err">{err}</p>}
      <div class="field"><label for="c-name">Назва групи</label><input class="input" id="c-name" name="name" required placeholder="Наприклад, Родина Коваленків" maxlength="60" value={v.name} /></div>
      <div class="row">
        <div class="field"><label for="c-budget">Бюджет подарунка</label><input class="input" id="c-budget" name="budget" placeholder="до 800 грн" maxlength="30" value={v.budget} /></div>
        <div class="field"><label for="c-date">Дата обміну</label><input class="input" id="c-date" name="date" type="date" value={v.date} /></div>
      </div>
      <div class="field"><label for="c-you">Ваше ім'я</label><input class="input" id="c-you" name="you" value={v.you} placeholder="Як вас бачитимуть учасники" maxlength="40" /></div>
      <div class="field"><label for="c-note">Повідомлення для учасників</label><textarea class="input" id="c-note" name="note" placeholder="Де і коли даруємо, тема свята, дрес-код…" maxlength="500">{v.note}</textarea></div>
      <div class="field"><span class="lab">Ваш аватар</span><AvatarPicker prefix="c" icon={user.avatar_icon} color={user.avatar_color} /></div>
      <label class="check"><input type="checkbox" name="join" value="1" checked /> Я теж беру участь у жеребкуванні</label>
      <div><button class="btn" type="submit">Створити і запросити</button></div>
    </form>
  </section>
</Layout>
